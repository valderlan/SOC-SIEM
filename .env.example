# Copy to .env and change the values for your lab.
SOCLAB_WAZUH_URL=https://127.0.0.1:55000
SOCLAB_WAZUH_USERNAME=wazuh-wui
SOCLAB_WAZUH_PASSWORD=CHANGE_ME

# False is convenient only for the lab's default self-signed certificate.
# Prefer true + SOCLAB_WAZUH_CA_BUNDLE in a real environment.
SOCLAB_WAZUH_VERIFY_TLS=false
# SOCLAB_WAZUH_CA_BUNDLE=/absolute/path/to/ca.pem

SOCLAB_HTTP_TIMEOUT_SECONDS=10
SOCLAB_MAX_AGENTS=500
